# ahamid.de - Serverkonfiguration (Apache/Plesk bei netcup)

ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> ohne www (direkt auf https)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://ahamid.de%{REQUEST_URI} [R=301,L]

  # http -> https (proxy-sicher: beruecksichtigt X-Forwarded-Proto)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://ahamid.de%{REQUEST_URI} [R=301,L]
</IfModule>

# Arbeits-/Backupdateien nie ausliefern
<FilesMatch "(?i)\.(md|zip|bak|old|orig|log|sql|conf|ini)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(_|\.git|LICENSE$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # HSTS 180 Tage, nur bei https. Ohne includeSubDomains (Subdomains wie webmail evtl. ohne Zertifikat).
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
  # CSP: nur eigene Inhalte. Das JSON-LD-Skript ist ein Datenblock und faellt nicht unter script-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

AddType font/woff2 .woff2
AddType image/svg+xml .svg
